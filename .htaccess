<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^backend/(\.env|\.env\..*|composer\.(json|lock)|artisan)$ - [F,L,NC]
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteRule ^(.*)$ backend/public/$1 [L]
</IfModule>
